.PHONY: patch.apply patch.revert patch.check patch.make

## Apply Patch Files
patch.apply:
	$(QUIET) $(call patch_src)

## Revert Patch Files
patch.revert:
	$(QUIET) $(call revert_patch_src)

## Check The Required Patch Before Build Or Installation
patch.check:
	$(QUIET) $(call check_patch_src)

patch.make:
	$(QUIET) mkdir -p $(TOP)/patch
	$(QUIET) $(call make_p0_patch)
