+// Monotonic time in milliseconds, not affected by wall clock changes.
+static long long monotonicMs()
+{
+	timespec ts;
+	clock_gettime(CLOCK_MONOTONIC, &ts);
+
+	return (long long) ts.tv_sec * 1000 + ts.tv_nsec / 1000000;
+}
+
+// Time left until the deadline in milliseconds. The result is never less than 1 because a zero socket timeout waits forever.
+static int remainingMs(long long deadline)
+{
+	long long left = deadline - monotonicMs();
+
+	if(left < 1)
+		left = 1;
+
+	if(left > INT_MAX)
+		left = INT_MAX;
+
+	return (int) left;
+}
